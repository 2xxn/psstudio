NEXT_PUBLIC_API_URL=/api

X_CLIENT_ID=your_client_id
X_CLIENT_SECRET=your_client_secret

BASE_URL=https://streetviewpublish.googleapis.com/v1/photo
AUTH_SCOPE=https://www.googleapis.com/auth/streetviewpublish

CBC_KEY=0123456789abcdef0123456789abcdef
REDIRECT_URI=http://localhost:3000/api/auth

# Analytics (optional)
# Defaults target the official Umami instance on photosphere.2xxn.dev.
# Self-hosted deployments: set your own values, or set the website ID to an empty string to disable.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# NEXT_PUBLIC_UMAMI_DOMAINS=photosphere.2xxn.dev